    "overrides": []
   },
   "options": {
    "showThresholdMarkers": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (increase(http_server_requests_seconds_bucket{uri=\"/api/v1/waiting/users\",method=\"POST\"}[$__range])))",
     "legendFormat": "p99",
     "instant": true
    }
   ]
  },
  {
   "id": 10,
   "type": "stat",
   "title": "끊긴 연결 정리 (선택 기간)",

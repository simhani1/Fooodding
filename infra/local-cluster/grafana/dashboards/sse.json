  {
   "id": 11,
   "type": "bargauge",
   "title": "이벤트 종류별 최대 크기 vs Nginx 버퍼(8KB)",
   "description": "SSE 한 프레임의 최대 바이트. 8KB 선을 넘으면 Nginx가 여러 번 나눠 읽음",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       },
       {
        "value": 4096,
        "color": "orange"
       },
       {
        "value": 8192,
        "color": "red"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "min": 0,

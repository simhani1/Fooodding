{
 "uid": "fooding-sse",
 "title": "푸딩 SSE 클러스터",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "살아있는 서버 수",
   "description": "Prometheus가 수집 중인 api 인스턴스 수. 2 미만이면 빨강",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "red"
       },
       {
        "value": 2,
        "color": "green"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(up{job=\"fooding-api\"})",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "현재 접속 중인 점주 화면",
   "description": "모든 서버가 들고 있는 SSE 연결 합계",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "blue"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(sse_connections_local)",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Redis에 기록된 연결",
   "description": "sse:conn:* 키 수. 위 값과 다르면 정리 안 된 연결(최대 30초 후 TTL 만료)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "purple"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(sse_connections_registry)",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "알림 발행 실패 (선택 기간)",
   "description": "Redis 발행 실패 건수. 예약은 성공했지만 알림이 못 나간 횟수",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       },
       {
        "value": 1,
        "color": "red"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(sse_events_publish_failed_total[$__range])) or vector(0)",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 5,
   "type": "bargauge",
   "title": "서버별 점주 연결 수",
   "description": "각 인스턴스가 들고 있는 SSE 연결. 한쪽 쏠림 확인용",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "blue"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sse_connections_local",
     "legendFormat": "{{instance}}",
     "instant": true
    }
   ]
  },
  {
   "id": 6,
   "type": "piechart",
   "title": "알림 전달 경로 (같은 서버 vs 다른 서버)",
   "description": "cross_instance = 요청 받은 서버와 점주가 붙은 서버가 달라 Redis Pub/Sub이 넘겨준 전달",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 4,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "pieType": "donut",
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value",
      "percent"
     ]
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (increase(sse_events_delivered_total[$__range]))",
     "legendFormat": "{{route}}",
     "instant": true
    }
   ]
  },
  {
   "id": 7,
   "type": "piechart",
   "title": "서버별 요청 분배 (nginx 라운드로빈)",
   "description": "인스턴스별 API 요청 비율. 반반에 가까워야 정상",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 4,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "pieType": "donut",
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value",
      "percent"
     ]
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (increase(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[$__range]))",
     "legendFormat": "{{instance}}",
     "instant": true
    }
   ]
  },
  {
   "id": 8,
   "type": "gauge",
   "title": "알림 지연 p99 (예약 → 점주 서버 도착)",
   "description": "Pub/Sub 발행부터 점주 연결 서버가 받기까지. 100ms 넘으면 주황, 500ms 넘으면 빨강",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       },
       {
        "value": 0.1,
        "color": "orange"
       },
       {
        "value": 0.5,
        "color": "red"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "min": 0,
     "max": 0.5
    },
    "overrides": []
   },
   "options": {
    "showThresholdMarkers": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (increase(sse_pubsub_latency_seconds_bucket[$__range])))",
     "legendFormat": "p99",
     "instant": true
    }
   ]
  },
  {
   "id": 9,
   "type": "gauge",
   "title": "손님 예약 응답 시간 p99",
   "description": "POST /api/v1/waiting/users. 점주 네트워크나 Redis 장애가 손님에게 번지지 않는지 확인",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 11,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       },
       {
        "value": 0.3,
        "color": "orange"
       },
       {
        "value": 1,
        "color": "red"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "min": 0,
     "max": 1
